#!/usr/bin/env bash
set -euo pipefail
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
work=$(mktemp -d)
out=$(mktemp -d)
trap 'rm -rf -- "$work" "$out"' EXIT
"$root/tools/build-release" "$out" >/dev/null
tar -xzf "$out/rosette-wire-0.1.0-rc.3.tar.gz" -C "$work"
sbcl_bin=$(command -v sbcl)
sbcl_core=$(sbcl --noinform --non-interactive --eval '(format t "~A" sb-ext:*core-pathname*)')
sbcl_home=$(dirname "$sbcl_core")
args=(--die-with-parent --unshare-user --unshare-pid --unshare-ipc --unshare-uts --unshare-cgroup-try --ro-bind /usr /usr --ro-bind /bin /bin --ro-bind /lib /lib --ro-bind-try /lib64 /lib64 --ro-bind /etc /etc --proc /proc --dev /dev --tmpfs /tmp --ro-bind "$sbcl_bin" /tmp/sbcl --ro-bind "$sbcl_home" /tmp/sbcl-home --bind "$work" /work --chdir "/work/rosette-wire-0.1.0-rc.3")
bwrap "${args[@]}" /usr/bin/env SBCL_HOME=/tmp/sbcl-home PATH=/tmp:/usr/bin:/bin /usr/bin/make test verify-export-id publication-check
echo 'clean-room: PASS (no home or garden filesystem mounted)'
