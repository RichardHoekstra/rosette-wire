#!/usr/bin/env -S sbcl --script
(require :asdf)
(require :uiop)
(defparameter *self* (or *load-truename* *load-pathname*))
(defparameter *root* (uiop:pathname-parent-directory-pathname (uiop:pathname-directory-pathname *self*)))
(asdf:initialize-output-translations '(:output-translations (t "/tmp/rosette-asdf-cache/") :ignore-inherited-configuration))
(asdf:initialize-source-registry `(:source-registry (:tree ,*root*) :ignore-inherited-configuration))
(asdf:load-system :wire-graph)
(let* ((descriptor (rosette-wire:make-wire-descriptor :name "smoke" :version "1.0.0" :imports nil :exports nil :effects '(:pure) :capabilities nil :adapter nil :verifiers nil))
       (graph (rosette-wire:make-wire-graph :name "smoke" :nodes nil :services nil :steps nil :inputs nil :outputs nil :capability-grants nil :required-evidence nil :limits '(("maxSteps" . 0))))
       (receipt (rosette-wire:run-wire-graph graph (rosette-wire:make-wire-runner) nil))
       (directory (uiop:ensure-directory-pathname (format nil "/tmp/rosette-cli-smoke-~D/" (get-universal-time))))
       (wire (merge-pathnames "wire.json" directory)) (graph-path (merge-pathnames "graph.json" directory)) (receipt-path (merge-pathnames "receipt.json" directory)))
  (ensure-directories-exist wire)
  (flet ((write-json (path value) (with-open-file (out path :direction :output :if-exists :supersede :if-does-not-exist :create) (write-string (rosette-wire:canonical-json value) out))))
    (write-json wire (rosette-wire:wire-descriptor->value descriptor))
    (write-json graph-path (rosette-wire:wire-graph->value graph))
    (write-json receipt-path (rosette-wire:wire-receipt->value receipt)))
  (dolist (args `(("describe" ,(namestring wire)) ("connect" ,(namestring graph-path)) ("validate" ,(namestring graph-path)) ("run" ,(namestring graph-path)) ("verify" ,(namestring receipt-path) "--graph" ,(namestring graph-path)) ("certify" ,(namestring graph-path))))
    (multiple-value-bind (out err code) (uiop:run-program (append (list (namestring (merge-pathnames "bin/rosette" *root*))) args) :output :string :error-output :string :ignore-error-status t)
      (declare (ignore err))
      (unless (zerop code) (error "CLI ~A failed with ~D: ~A" (first args) code out))
      (rosette-json:json-parse out)))
  (format t "cli-smoke: PASS (6 commands)~%"))
